<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:LoginFlow.Login"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="LoginFlow.Login.LoginPage"
             x:DataType="vm:LoginViewModel"
             Title="LoginPage">
    <ContentPage.BindingContext>
        <vm:LoginViewModel />
    </ContentPage.BindingContext>
    <VerticalStackLayout>
        <Label 
            Text="Welcome to .NET MAUI!"
            VerticalOptions="Center" 
            HorizontalOptions="Center" />
        <Entry Text="{Binding Name}">
            <Entry.Behaviors>
                <toolkit:MultiValidationBehavior Flags="ValidateOnValueChanged"
                                                 IsValid="{Binding IsNameValid, Mode=TwoWay}">
                    <toolkit:TextValidationBehavior MaximumLength="100"
                                                    MinimumLength="1" />
                </toolkit:MultiValidationBehavior>
            </Entry.Behaviors>
        </Entry>
        <Button Text="Login"
                Command="{Binding LoginCommand}"/>
    </VerticalStackLayout>
</ContentPage>