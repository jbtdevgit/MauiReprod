<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="LoginFlow.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:LoginFlow"
    xmlns:login="clr-namespace:LoginFlow.Login"
    Title="LoginFlow">

    <ShellContent
        Title="Login"
        ContentTemplate="{DataTemplate login:LoginPage}"/>
    <ShellContent
            Title="Init"
            ContentTemplate="{DataTemplate local:InitialisePage}"
            Route="InitialisePage" />

    <FlyoutItem FlyoutDisplayOptions="AsMultipleItems">
        <ShellContent
            Title="Home"
            ContentTemplate="{DataTemplate local:MainPage}"
            Route="MainPage" />
    </FlyoutItem>

</Shell>
